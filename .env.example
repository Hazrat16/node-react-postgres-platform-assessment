# Copy to .env (or run `make env`, which generates random passwords).
# .env is git-ignored. Use URL-safe values (letters/digits) because the
# passwords are embedded in connection URLs.
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=change-me
DB_PORT=5432
REPLICATION_PASSWORD=change-me-too
REDIS_PASSWORD=change-me-three

# Host port for the UI
FRONTEND_PORT=8080
